{
  "name": "phpaml/data",
  "description": "Typed data access for PHPAML, AML View and standalone PHP applications.",
  "type": "library",
  "license": "MIT",
  "keywords": ["phpaml", "database", "orm", "sqlite", "mysql", "postgresql"],
  "homepage": "https://phpaml.com",
  "support": {
    "issues": "https://github.com/MR-C0DE/phpaml-data/issues",
    "source": "https://github.com/MR-C0DE/phpaml-data"
  },
  "require": {
    "php": "^8.2",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "AML\\Data\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "test:databases": "php tests/databases.php"
  },
  "extra": {
    "phpaml": {
      "type": "data-library",
      "version": "0.1.0-alpha.2"
    }
  }
}
