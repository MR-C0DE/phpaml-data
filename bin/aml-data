#!/usr/bin/env php
<?php

declare(strict_types=1);

$package = dirname(__DIR__);
$project = getcwd() ?: '.';
$projectAutoload = $project . '/runtime/autoload.php';
if (is_file($projectAutoload)) {
    require_once $projectAutoload;
}
$composer = $package . '/vendor/autoload.php';
if (!class_exists(AML\Data\Commands\DataCommand::class) && is_file($composer)) {
    require $composer;
} elseif (!class_exists(AML\Data\Commands\DataCommand::class)) {
    require $package . '/tests/bootstrap.php';
    $mongoSource = dirname($package) . '/phpaml-data-mongodb/src/';
    if (is_dir($mongoSource)) {
        spl_autoload_register(static function (string $class) use ($mongoSource): void {
            $prefix = 'AML\\Data\\MongoDB\\';
            if (str_starts_with($class, $prefix)) require $mongoSource . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
        });
    }
}
$configPath = $project . '/configs/data.php';
$manifestPath = $project . '/phpaml.json';
$manifest = is_file($manifestPath) ? json_decode((string) file_get_contents($manifestPath), true) : null;
if (is_array($manifest['data'] ?? null) && class_exists(PHPAML\Config\ApplicationConfig::class)) {
    $applicationConfig = PHPAML\Config\ApplicationConfig::load($project);
    $config = $applicationConfig['data'] ?? $manifest['data'];
} else {
    $config = is_array($manifest['data'] ?? null)
        ? $manifest['data']
        : (is_file($configPath) ? require $configPath : ['database' => 'runtime/storage/app.sqlite']);
}
if (!is_array($config)) {
    fwrite(STDERR, "Erreur : la configuration Data est invalide.\n");
    exit(1);
}
try {
    $arguments = array_slice($_SERVER['argv'] ?? [], 1);
    $command = array_shift($arguments) ?? 'data:doctor';
    exit((new AML\Data\Commands\DataCommand($project, $config))->run($command, $arguments));
} catch (Throwable $error) {
    fwrite(STDERR, 'Erreur : ' . $error->getMessage() . PHP_EOL);
    exit(1);
}
